{
  "logging": {
    "debug": true,
    "syslog": {
      "enabled": false
    }
  },
  "server": {
    "listen": {
      "address": ":3000"
    },
    "readOnly": false,
    "tls": {
      "enabled": false,
      "mutualTLS": false
    },
    "status": {
      "endpoint": "/api/status",
      "verifyOU": false
    }
  },
  "topology": {
    "mysql": {
      "user": "ci",
      "password": "ci",
      "defaultPort": 3306,
      "useMixedTLS": false
    },
    "discovery": {
      "useShowReplicaHosts": true,
      "pollSeconds": 1,
      "seeds": [
        "127.0.0.1:10111"
      ]
    },
    "hostname": {
      "resolveMethod": "none",
      "mysqlResolveMethod": "@@report_host",
      "skipBinlogServerUnresolveCheck": true,
      "resolveExpiryMinutes": 60
    },
    "candidate": {
      "expireMinutes": 60
    },
    "replication": {
      "lagQuery": "select timestampdiff(second, ts, now()) from test.heartbeat"
    },
    "classification": {
      "detectClusterAliasQuery": "SELECT 'ci'",
      "detectClusterDomainQuery": "",
      "detectInstanceAliasQuery": "",
      "detectPromotionRuleQuery": "",
      "detectDataCenterQuery": "select CASE @@port WHEN 10111 THEN 'dc-east-1' WHEN 10112 THEN 'dc-east-1' WHEN 10113 THEN 'dc-east-2' WHEN 10114 THEN 'dc-west' END",
      "detectRegionQuery": "select IF(@@port = 10114, 'rgn-west', 'rgn-east')",
      "detectPhysicalEnvironmentQuery": "select 'prod'",
      "detectSemiSyncEnforcedQuery": ""
    },
    "analysis": {
      "reduceCount": false
    }
  },
  "metadata": {
    "type": "sqlite",
    "sqlite": {
      "dataFile": "/tmp/orchestrator.sqlite3"
    }
  },
  "mysql": {
    "connectTimeoutSeconds": 1
  },
  "authentication": {
    "method": ""
  },
  "agents": {
    "serveHTTP": false
  },
  "pseudoGTID": {
    "binlogEventsChunkSize": 10000,
    "skipBinlogContaining": []
  },
  "raft": {
    "nodeID": "ci-node-1",
    "dataDir": "/tmp/orchestrator-ci-raft",
    "bind": "127.0.0.1",
    "defaultPort": 10008
  },
  "consul": {
    "address": "127.0.0.1:8500",
    "scheme": "http",
    "aclToken": "",
    "datacenter": "",
    "tls": {
      "skipVerify": false
    },
    "httpTimeoutSeconds": 60,
    "kv": {
      "provider": "consul",
      "crossDataCenterDistribution": false
    }
  }
}
