#!/bin/bash

set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root" || exit 1

failures=0

fail() {
  echo "ERROR: $*" >&2
  failures=$((failures + 1))
}

strip_link_title() {
  local target="$1"
  if [[ "${target:0:1}" == "<" ]]; then
    target="${target#<}"
    target="${target%%>*}"
  else
    target="${target%% *}"
  fi
  printf '%s' "$target"
}

check_target() {
  local source="$1"
  local raw_target="$2"
  local target
  local path
  local slug

  target="$(strip_link_title "$raw_target")"
  target="${target%%#*}"
  target="${target%%\?*}"

  [[ -n "$target" ]] || return 0

  case "$target" in
    http://*|https://*|mailto:*|data:*|javascript:*|ftp:*)
      case "$target" in
        https://github.com/SisyphusSQ/orchestrator/wiki/*)
          slug="${target#https://github.com/SisyphusSQ/orchestrator/wiki/}"
          slug="${slug%%/*}"
          [[ -f "docs/wiki/${slug}.md" ]] || fail "$source links to unmanaged or missing Wiki page: $raw_target"
          ;;
        https://github.com/SisyphusSQ/orchestrator/blob/main/*)
          path="${target#https://github.com/SisyphusSQ/orchestrator/blob/main/}"
          [[ -e "$path" ]] || fail "$source links to missing repository file: $raw_target"
          ;;
        https://github.com/SisyphusSQ/orchestrator/tree/main/*)
          path="${target#https://github.com/SisyphusSQ/orchestrator/tree/main/}"
          [[ -d "$path" ]] || fail "$source links to missing repository directory: $raw_target"
          ;;
      esac
      return 0
      ;;
  esac

  if [[ "$target" == /* ]]; then
    path=".${target}"
  else
    path="$(dirname "$source")/$target"
  fi

  if [[ -e "$path" ]]; then
    return 0
  fi
  if [[ "$source" == docs/wiki/* && -e "${path}.md" ]]; then
    return 0
  fi
  fail "$source links to missing local target: $raw_target"
}

echo "# Validating Markdown links and images"
while IFS=$'\t' read -r source target; do
  [[ -n "$source" && -n "$target" ]] || continue
  check_target "$source" "$target"
done < <(
  find README.md README.zh-CN.md docs -type f -name '*.md' -print0 |
    while IFS= read -r -d '' file; do
      perl -0777 -ne 's/```.*?```//gs; s/~~~.*?~~~//gs; s/`[^`\n]*`//g; while (/!?\[[^]]*\]\(([^)\n]+)\)/g) { print "$ARGV\t$1\n" }' "$file"
    done
)

echo "# Validating bilingual README and generated screenshots"
[[ -f README.md ]] || fail "English README.md is missing"
[[ -f README.zh-CN.md ]] || fail "Chinese README.zh-CN.md is missing"
grep -Fq '(README.zh-CN.md)' README.md ||
  fail "README.md does not link to README.zh-CN.md"
grep -Fq '(README.md)' README.zh-CN.md ||
  fail "README.zh-CN.md does not link to README.md"
for screenshot in cluster-overview.png topology-detail.png recovery-configuration.png; do
  screenshot_path="docs/assets/screenshots/$screenshot"
  [[ -f "$screenshot_path" ]] || fail "generated documentation screenshot is missing: $screenshot_path"
  grep -Fq "($screenshot_path)" README.md || fail "README.md does not use $screenshot_path"
  grep -Fq "($screenshot_path)" README.zh-CN.md || fail "README.zh-CN.md does not use $screenshot_path"
done

wiki_dir="docs/wiki"
manifest="$wiki_dir/managed-pages.txt"

echo "# Validating Wiki manifest"
[[ -f "$manifest" ]] || fail "missing $manifest"
[[ -f "$wiki_dir/Home.md" ]] || fail "missing Wiki Home.md"
[[ -f "$wiki_dir/_Sidebar.md" ]] || fail "missing Wiki _Sidebar.md"
[[ -f "$wiki_dir/_Footer.md" ]] || fail "missing Wiki _Footer.md"

duplicate_pages="$(sort "$manifest" | uniq -d)"
[[ -z "$duplicate_pages" ]] || fail "duplicate Wiki manifest entries: $duplicate_pages"

manifest_count=0
while IFS= read -r page || [[ -n "$page" ]]; do
  [[ -n "$page" ]] || continue
  manifest_count=$((manifest_count + 1))

  if [[ ! "$page" =~ ^[A-Za-z0-9._-]+\.md$ ]] || [[ "$page" == */* ]]; then
    fail "unsafe Wiki manifest path: $page"
    continue
  fi
  [[ -f "$wiki_dir/$page" ]] || {
    fail "manifest page is missing: $page"
    continue
  }

  case "$page" in
    EN-*.md)
      topic="${page#EN-}"
      counterpart="ZH-$topic"
      slug="${counterpart%.md}"
      grep -Fq "/wiki/$slug" "$wiki_dir/$page" ||
        fail "$page does not link to $counterpart"
      grep -Fxq "$counterpart" "$manifest" ||
        fail "$page has no Chinese manifest pair"
      ;;
    ZH-*.md)
      topic="${page#ZH-}"
      counterpart="EN-$topic"
      slug="${counterpart%.md}"
      grep -Fq "/wiki/$slug" "$wiki_dir/$page" ||
        fail "$page does not link to $counterpart"
      grep -Fxq "$counterpart" "$manifest" ||
        fail "$page has no English manifest pair"
      ;;
  esac

  case "$page" in
    Home.md|_Sidebar.md|_Footer.md)
      ;;
    *)
      slug="${page%.md}"
      grep -Fq "/wiki/$slug" "$wiki_dir/Home.md" "$wiki_dir/_Sidebar.md" ||
        fail "$page is not reachable from Home.md or _Sidebar.md"
      ;;
  esac
done < "$manifest"

source_count=0
for page_path in "$wiki_dir"/*.md; do
  page="$(basename "$page_path")"
  [[ "$page" == "README.md" ]] && continue
  source_count=$((source_count + 1))
  grep -Fxq "$page" "$manifest" || fail "Wiki page is not managed: $page"
done

[[ "$manifest_count" -eq "$source_count" ]] ||
  fail "Wiki manifest count $manifest_count does not match managed source count $source_count"

echo "# Validating package guide coverage"
for package_guide in "$wiki_dir/EN-Package-Guide.md" "$wiki_dir/ZH-Package-Guide.md"; do
  [[ -f "$package_guide" ]] || {
    fail "package guide is missing: $package_guide"
    continue
  }
  while IFS= read -r package_dir; do
    [[ -n "$package_dir" ]] || continue
    grep -Fq "\`$package_dir\`" "$package_guide" ||
      fail "$package_guide does not document Go package directory: $package_dir"
  done < <(
    git ls-files -- '*.go' |
      while IFS= read -r go_file; do dirname "$go_file"; done |
      sort -u
  )
done

echo "# Validating detailed Wiki reference coverage"
for config_reference in "$wiki_dir/EN-Configuration-Reference.md" "$wiki_dir/ZH-Configuration-Reference.md"; do
  while IFS= read -r config_domain; do
    [[ -n "$config_domain" ]] || continue
    grep -Fq "\`$config_domain\`" "$config_reference" ||
      fail "$config_reference does not document top-level configuration domain: $config_domain"
  done < <(
    sed -n '/^type Configuration struct {/,/^}/p' internal/config/model.go |
      sed -n 's/.*json:"\([^"]*\)".*/\1/p'
  )
done

for recovery_reference in "$wiki_dir/EN-Recovery-Configuration.md" "$wiki_dir/ZH-Recovery-Configuration.md"; do
  while IFS= read -r policy_field; do
    [[ -n "$policy_field" ]] || continue
    grep -Fq "\`$policy_field\`" "$recovery_reference" ||
      fail "$recovery_reference does not document recovery policy field: $policy_field"
  done < <(
    sed -n '/^type RecoveryPolicy struct {/,/^}/p' internal/models/domain/recovery_policy.go |
      sed -n 's/.*json:"\([^"]*\)".*/\1/p'
  )

  while IFS= read -r hook_phase; do
    [[ -n "$hook_phase" ]] || continue
    grep -Fq "\`$hook_phase\`" "$recovery_reference" ||
      fail "$recovery_reference does not document recovery hook phase: $hook_phase"
  done < <(
    sed -n '/^var RecoveryHookPhases = /,/^}/p' internal/models/domain/recovery_policy.go |
      grep -Eo '"[a-z_]+"' |
      tr -d '"'
  )
done

for cli_reference in "$wiki_dir/EN-CLI-Reference.md" "$wiki_dir/ZH-CLI-Reference.md"; do
  while IFS= read -r command_name; do
    [[ -n "$command_name" ]] || continue
    grep -Fq "\`$command_name\`" "$cli_reference" ||
      fail "$cli_reference does not index CLI command: $command_name"
  done < <(sed -n 's/^[[:space:]]*"name":[[:space:]]*"\([^"]*\)".*/\1/p' tools/orch-cli/internal/cmd/catalog.json)
done

for web_reference in "$wiki_dir/EN-Web-Console.md" "$wiki_dir/ZH-Web-Console.md"; do
  while IFS= read -r web_route; do
    [[ -n "$web_route" ]] || continue
    grep -Fq "\`$web_route\`" "$web_reference" ||
      fail "$web_reference does not document Web route: $web_route"
  done < <(sed -n 's/.*path="\([^"]*\)".*/\1/p' web/src/app/app.tsx | sort -u)
  for help_route in about home faq keep-calm; do
    grep -Fq "\`/$help_route\`" "$web_reference" ||
      fail "$web_reference does not document generated help route: /$help_route"
  done
  for screenshot in cluster-overview.png topology-detail.png recovery-configuration.png; do
    grep -Fq "/$screenshot" "$web_reference" ||
      fail "$web_reference does not embed documentation screenshot: $screenshot"
  done
done

for api_reference in "$wiki_dir/EN-API-Reference.md" "$wiki_dir/ZH-API-Reference.md"; do
  for route_family in raft/ recovery-policy recovery-hook replication-analysis audit-recovery discover cluster/ relocate move-below-gtid match-replicas begin-maintenance begin-downtime tag/ submit-masters-to-kv-stores; do
    grep -Fq "$route_family" "$api_reference" ||
      fail "$api_reference does not document API route family: $route_family"
  done
done

echo "# Checking documentation boundaries"
while IFS= read -r legacy_page; do
  fail "legacy top-level documentation must be migrated to the Wiki or a durable asset directory: $legacy_page"
done < <(find docs -maxdepth 1 -type f -name '*.md' ! -name 'README.md' -print | sort)

if [[ -d docs/images ]]; then
  while IFS= read -r legacy_image; do
    fail "orphaned legacy documentation image must be removed: $legacy_image"
  done < <(find docs/images -type f -print | sort)
fi

[[ -f docs/README.md ]] || fail "documentation index is missing"
[[ -f docs/wiki/README.md ]] || fail "versioned Wiki source index is missing"
[[ -f docs/verification/orch-cli-too-426.md ]] ||
  fail "moved TOO-426 verification record is missing"

echo "# Checking metadata schema documentation"
[[ -f docs/schema/README.md ]] || fail "metadata schema index is missing"
grep -Fq '(schema/README.md)' docs/README.md ||
  fail "metadata schema index is not linked from docs/README.md"
while IFS= read -r -d '' page; do
  page_name="$(basename "$page")"
  grep -Fq -- "($page_name)" docs/schema/*.md ||
    fail "$page is not linked from another metadata schema document"
done < <(find docs/schema -type f -name '*.md' ! -name 'README.md' -print0)

if [[ "$failures" -ne 0 ]]; then
  echo "Documentation validation failed with $failures error(s)." >&2
  exit 1
fi

echo "Documentation validation passed: $manifest_count managed Wiki pages."
